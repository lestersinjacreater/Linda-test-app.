# Copy to .env.production on the server and fill in. This file is git-ignored: NEVER commit the real one.
# (Compose reads values literally inside single quotes, which the password hash below needs.)

# --- Where the audience and the phones reach the server -----------------------------------------------------
# With a domain name (recommended: free automatic HTTPS):
#   SITE_ADDRESS=linda.example.com          PUBLIC_URL=https://linda.example.com
# With only an IP address (plain http, fine for a rehearsal or the laptop backup):
#   SITE_ADDRESS=:80                        PUBLIC_URL=http://203.0.113.10
SITE_ADDRESS=linda.example.com
PUBLIC_URL=https://linda.example.com

# --- Presenter login for Start blast / Reset (the dashboard asks once) ------------------------------------------
# Make the hash with:  docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-long-password'
PRESENTER_USER=presenter
PRESENTER_HASH='paste-the-bcrypt-hash-here'
# The fraud-team console's internal key (contract 5.15): any long random text, e.g. from: openssl rand -hex 24
FRAUD_TEAM_KEY=change-me-to-long-random-text

# --- Database ---------------------------------------------------------------------------------------------------
# Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Optional tuning (defaults shown) ---------------------------------------------------------------------------
# SIM_SPEED=20                 # simulated seconds per real second; lower is slower and easier to narrate
# SIM_SEED=42                  # same seed, same demo
# RADAR_MIN_DEVICES=3
# RADAR_MIN_SCORE=2.4
# RADAR_DEMO_TRUSTED_PREFIX=5111   # demo only; set to empty to switch off
# RADAR_DEMO_TRUSTED_TRUST=0.85     # demo phones' starting trust: 3 of them confirm (3 x 0.85 x 0.998 = 2.54 >= 2.4)
# SIM_FEATURE_SHARE=0.6             # basic phones among simulated phones in the adoption runs (an assumption)

# --- The real basic phone on the table (optional; root CLAUDE.md item 6) ---------------------------------------
# Comma-separated team phones that receive the network's WARNING as a real SMS (never the scam text).
# REAL_PHONES=
# Africa's Talking. "sandbox" only reaches AT's web simulator; a real SIM needs a live account with credit.
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=

# Payment demo: Daraja SANDBOX only (developer.safaricom.co.ke, a sandbox app's key and secret, and the sandbox
# passkey for shortcode 174379). Callback: https://DOMAIN/radar/v1/payments/stk/callback. Empty = the payment demo is off.
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=
# The team's phones that may get the demo payment prompt (2547XXXXXXXX, comma separated). Never commit real numbers.
# DARAJA_ALLOWED_PAYERS=
