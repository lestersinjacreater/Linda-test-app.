# radar
DATABASE_URL=postgresql://linda:linda@postgres:5432/linda
TELCO_URL=http://telco:8000
RADAR_MIN_DEVICES=3
RADAR_MIN_SCORE=2.4
# Devices without an integrity token can earn trust up to this ceiling (the spec's literal 0.3 made confirmation impossible).
RADAR_NO_TOKEN_TRUST_CAP=1.0
# DEMO ONLY: simulator phones (device ids starting with this prefix) start with this trust. Leave the prefix empty in production.
# 0.85 so that 3 phones confirm (3 x 0.85 x 0.998 = 2.54 >= 2.4); at 0.8 it took 4 (2.395).
RADAR_DEMO_TRUSTED_PREFIX=5111
RADAR_DEMO_TRUSTED_TRUST=0.85
# Mock fraud intelligence (fraudintel/). Empty = off. In production: Safaricom's fraud systems.
FRAUDINTEL_URL=http://fraudintel:8002
INTEL_SYNC_S=30
# simulator
RADAR_URL=http://radar:8001
SIM_SPEED=20
SIM_SEED=42
# Simulator phones' device ids start with this; must equal RADAR_DEMO_TRUSTED_PREFIX above (demo only)
SIM_DEVICE_PREFIX=5111
# The team's own basic phones for the table demo, comma separated (0712..., +254712... or 254712...). NEVER commit real numbers.
REAL_PHONES=
# Basic phones among all simulated phones in the adoption runs (?adoption=0.5|1|2). An assumption, not a statistic.
SIM_FEATURE_SHARE=0.6
# Africa's Talking, for the warning SMS to REAL_PHONES. Username "sandbox" only reaches AT's web simulator;
# a live account (with credit, and the organisers' OK) reaches a real SIM. Empty key: nothing is sent.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Daraja sandbox (never live credentials)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
# dashboard (read at BUILD time; the browser connects to these, so use an address the presenter's browser can reach)
NEXT_PUBLIC_TELCO_API=http://localhost:8000
NEXT_PUBLIC_TELCO_WS=ws://localhost:8000/events
