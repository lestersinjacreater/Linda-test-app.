# Caddy is the only thing the internet can reach. It gives us HTTPS, and exposes ONLY the paths below.
#   {$SITE_ADDRESS}  a domain name (Caddy gets a free HTTPS certificate by itself), or ":80" for plain http on an IP address.
#   /                the dashboard (public: it is the screen the audience watches)
#   /radar/*         the radar: phones send reports and sync the blocklist here (https://DOMAIN/radar is the server address typed into the app)
#   /telco/...       the simulator: only the read-only feeds the dashboard needs are public
#   /telco/scenarios/*, /telco/reset   start/stop the demo: protected by the presenter's password
#   /fraud/*         the mock fraud team (inbox of reports, flag a number live): presenter's password
#   /fraud-team      the fraud-team console page, and /radar/v1/fraud-team/* its data (FULL numbers): presenter's
#                    password, then Caddy adds the internal X-Fraud-Team-Key the gateway checks (contract 5.15)
# Everything else of the simulator (/network/confirm, /deliveries, /history) stays on the private docker network.
# Upstreams: the docker service names by default; the all-in-one Render box sets *_UPSTREAM=127.0.0.1:port (deploy/render).

{$SITE_ADDRESS} {
	encode gzip

	@telco_public path /telco/events /telco/metrics /telco/population /telco/health
	handle @telco_public {
		uri strip_prefix /telco
		reverse_proxy {$TELCO_UPSTREAM:telco:8000}
	}

	@telco_control path /telco/scenarios/* /telco/reset
	handle @telco_control {
		basic_auth {
			{$PRESENTER_USER} {$PRESENTER_HASH}
		}
		uri strip_prefix /telco
		reverse_proxy {$TELCO_UPSTREAM:telco:8000}
	}

	handle /telco/* {
		respond "Not found" 404
	}

	handle /fraud/* {
		basic_auth {
			{$PRESENTER_USER} {$PRESENTER_HASH}
		}
		uri strip_prefix /fraud
		reverse_proxy {$FRAUD_UPSTREAM:fraudintel:8002}
	}

	handle /radar/v1/fraud-team/* {
		basic_auth {
			{$PRESENTER_USER} {$PRESENTER_HASH}
		}
		uri strip_prefix /radar
		reverse_proxy {$RADAR_UPSTREAM:radar:8001} {
			header_up X-Fraud-Team-Key {$FRAUD_TEAM_KEY}
		}
	}

	handle /radar/* {
		uri strip_prefix /radar
		reverse_proxy {$RADAR_UPSTREAM:radar:8001} {
			header_up -X-Fraud-Team-Key
		}
	}

	handle /fraud-team* {
		basic_auth {
			{$PRESENTER_USER} {$PRESENTER_HASH}
		}
		reverse_proxy {$DASHBOARD_UPSTREAM:dashboard:3000}
	}

	handle {
		reverse_proxy {$DASHBOARD_UPSTREAM:dashboard:3000}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}
}
